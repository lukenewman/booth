{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm install)",
      "Bash(pnpm install *)",
      "Bash(pnpm tsc)",
      "Bash(pnpm tsc *)",
      "Bash(pnpm check)",
      "Bash(pnpm check *)",
      "Bash(pnpm verify scripts/*)",
      "Bash(pnpm dev)",
      "Bash(pnpm dev *)",
      "Bash(pnpm add *)",
      "Bash(pnpm rebuild *)",
      "Bash(pnpm exec *)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git add *)",
      "Bash(git rm *)",
      "Bash(git mv *)",
      "Bash(git commit -m *)",
      "Bash(git commit --amend --no-edit)",
      "Bash(git log)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git stash)",
      "Bash(git stash *)",
      "Bash(mkdir -p *)",
      "Bash(touch *)",
      "Bash(ls)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(curl http://localhost:*)",
      "Bash(curl -X POST http://localhost:*)",
      "Bash(curl -i http://localhost:*)",
      "Bash(curl -i -X POST http://localhost:*)",
      "Bash(curl -s http://localhost:*)",
      "Bash(sqlite3 ./.booth/booth.db *)",
      "Bash(sqlite3 .booth/booth.db *)",
      "Bash(rm -rf .booth)",
      "Bash(rm -rf .booth/)"
    ]
  }
}

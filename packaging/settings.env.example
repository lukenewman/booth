# booth settings. After changing anything here, close the booth window and
# double-click Booth.command again.

# Required. Create a token at https://www.discogs.com/settings/developers
# ("Generate new token") and paste it after the = sign.
DISCOGS_TOKEN=

# Optional: import your Apple Music library. In Music, open Settings →
# Advanced and turn on "Share iTunes Library XML with other applications",
# then put the file's path here, e.g.
#   ITUNES_XML_PATH=/Users/yourname/Music/Music/Library.xml
ITUNES_XML_PATH=
